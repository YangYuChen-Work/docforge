# Copy this file to .env for local development.
# Never commit the real .env file or paste its contents into chat, code, or logs.

APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
STORAGE_ROOT=./data

# Use mock for development without a key; use deepseek for the real AI path.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseekv4-pro
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# Bounded parallelism for independent initial chapter generation.
GENERATION_CONCURRENCY=4
